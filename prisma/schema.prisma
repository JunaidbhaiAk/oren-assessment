generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id         String          @id @default(cuid())
  name       String          @unique
  createdAt  DateTime        @default(now())
  users      User[]
  plants     Plant[]
  changeLogs ChangeLog[]
  reports    MonthlyReport[]
}

model User {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  /// Values from ROLES in src/lib/roles.ts. A user can hold more than one role.
  roles     String[]
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Plants whose data this user is responsible for.
  plants    Plant[]     @relation("PlantDataOwners")
  changes   ChangeLog[]
  createdAt DateTime    @default(now())
}

enum PlantType {
  INTEGRATED
  GRINDING_UNIT
}

model Plant {
  id                String          @id @default(cuid())
  /// The company's own code for the plant, for example P01.
  code              String
  name              String
  town              String
  state             String
  type              PlantType
  cementCapacityTpa Int
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dataOwners        User[]          @relation("PlantDataOwners")
  reports           MonthlyReport[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([companyId, code])
}

/// Who changed what, and when. Written by recordChange in src/server/helpers/changeLog.ts.
model ChangeLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String
  action      String
  /// { field: { from, to } }
  changes     Json
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: NoAction)
  createdAt   DateTime @default(now())

  @@index([companyId, entityType, entityId])
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

/// One plant's data for one calendar month. A month with no row has not been started.
model MonthlyReport {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plantId       String
  plant         Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  year          Int
  /// 1 to 12.
  month         Int
  status        ReportStatus @default(DRAFT)
  /// The reviewer's comment when the month was sent back.
  reviewComment String?
  submittedAt   DateTime?
  lines         ReportLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([plantId, year, month])
  @@index([companyId, status])
}

/// One item of a month, as the plant entered it. `itemKey` is a key from EMISSION_FACTORS.
model ReportLine {
  id       String        @id @default(cuid())
  reportId String
  report   MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  itemKey  String
  quantity Float
  /// The unit the plant entered, a key from UNITS in src/lib/units.ts.
  unit     String

  @@unique([reportId, itemKey])
}
